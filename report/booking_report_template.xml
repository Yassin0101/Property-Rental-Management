<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_booking_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Booking Confirmation</h2>
                        <div class="row mt-4 mb-4">
                            <div class="col-6">
                                <strong>Booking Reference:</strong>
                                <p t-field="o.name"/>
                            </div>
                            <div class="col-6">
                                <strong>Status:</strong>
                                <p t-field="o.state"/>
                            </div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Customer</strong>
                                <p t-field="o.customer_id.name"/>
                            </div>
                            <div class="col-6">
                                <strong>Property</strong>
                                <p t-field="o.property_id.name"/>
                                <p t-field="o.property_id.address"/>
                            </div>
                        </div>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Check-In</th>
                                    <th>Check-Out</th>
                                    <th>Nights</th>
                                    <th>Price / Night</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span t-field="o.check_in"/></td>
                                    <td><span t-field="o.check_out"/></td>
                                    <td><span t-field="o.nights"/></td>
                                    <td><span t-field="o.price_per_night"/></td>
                                    <td><span t-field="o.total_amount"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <p t-if="o.notes">
                            <strong>Notes:</strong> <span t-field="o.notes"/>
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
