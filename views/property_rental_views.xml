<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tree View -->
        <record id="view_rental_property_tree" model="ir.ui.view">
            <field name="name">rental.property.tree</field>
            <field name="model">rental.property</field>
            <field name="arch" type="xml">
                <tree decoration-success="status=='available'" decoration-danger="status=='booked'" decoration-muted="status=='maintenance'">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="property_type"/>
                    <field name="city"/>
                    <field name="price_per_night"/>
                    <field name="capacity"/>
                    <field name="status"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_rental_property_form" model="ir.ui.view">
            <field name="name">rental.property.form</field>
            <field name="model">rental.property</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_set_available" string="Set Available" type="object"
                                class="btn-primary" invisible="status == 'available'"/>
                        <button name="action_set_maintenance" string="Set Under Maintenance" type="object"
                                invisible="status == 'maintenance'"/>
                        <field name="status" widget="statusbar" statusbar_visible="available,booked,maintenance"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_bookings" type="object" class="oe_stat_button" icon="fa-calendar">
                                <field name="booking_count" widget="statinfo" string="Bookings"/>
                            </button>
                        </div>
                        <field name="image" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="e.g. Seaside Villa 12"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="property_type"/>
                                <field name="capacity"/>
                            </group>
                            <group>
                                <field name="address"/>
                                <field name="city"/>
                                <field name="price_per_night"/>
                            </group>
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Kanban View -->
        <record id="view_rental_property_kanban" model="ir.ui.view">
            <field name="name">rental.property.kanban</field>
            <field name="model">rental.property</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="name"/>
                    <field name="status"/>
                    <field name="price_per_night"/>
                    <field name="city"/>
                    <field name="image"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <img t-att-src="kanban_image('rental.property', 'image', record.id.raw_value)" alt="Property"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong><field name="name"/></strong>
                                    <div><field name="city"/></div>
                                    <div>
                                        <field name="price_per_night"/> / night
                                    </div>
                                    <span class="badge" t-attf-class="badge-{{record.status.raw_value == 'available' and 'success' or record.status.raw_value == 'booked' and 'danger' or 'secondary'}}">
                                        <field name="status"/>
                                    </span>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_rental_property_search" model="ir.ui.view">
            <field name="name">rental.property.search</field>
            <field name="model">rental.property</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="city"/>
                    <filter string="Available" name="filter_available" domain="[('status','=','available')]"/>
                    <filter string="Booked" name="filter_booked" domain="[('status','=','booked')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Type" name="group_type" context="{'group_by':'property_type'}"/>
                        <filter string="City" name="group_city" context="{'group_by':'city'}"/>
                        <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_rental_property" model="ir.actions.act_window">
            <field name="name">Properties</field>
            <field name="res_model">rental.property</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="view_rental_property_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add your first rental property
                </p>
            </field>
        </record>

    </data>
</odoo>
